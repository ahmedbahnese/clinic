# ==============================================================================
# BSCH Clinics — مستشفى الأطفال التخصصي بالبحيرة
# Environment Variables Template / قالب المتغيرات البيئية
# ==============================================================================
# IMPORTANT:
# 1. Do NOT put real production credentials directly into this file.
# 2. For local development: Copy this file to `.env.local` and paste your actual keys:
#      cp .env.example .env.local
# 3. For Vercel production: Add these variables under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT-SIDE CONFIGURATION (PUBLIC)
# ------------------------------------------------------------------------------
# Where to find in Supabase Dashboard:
# -> Go to: Project Settings (gear icon in sidebar) -> API
# -> Under "Project URL", copy the URL value.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Where to find in Supabase Dashboard:
# -> Go to: Project Settings -> API
# -> Under "Project API keys", find the key labeled "anon" / "public" and copy it.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-jwt-token"

# ------------------------------------------------------------------------------
# 2. SUPABASE SERVER-SIDE PRIVILEGED KEYS (CONFIDENTIAL - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# The service_role key bypasses Row Level Security (RLS) for server-side admin
# operations such as atomic booking sequence generation, cancellation review,
# and staff provisioning. NEVER share or expose this key to browser code.
#
# Where to find in Supabase Dashboard:
# -> Go to: Project Settings -> API
# -> Under "Project API keys", find the key labeled "service_role" / "secret".
# -> Click "Reveal" and copy the token.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-token"
# Alias accepted by certain legacy helper functions (set to the exact same value as above)
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-token"

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE DIRECT CONNECTION STRINGS (POSTGRESQL)
# ------------------------------------------------------------------------------
# Required for running migrations, Prisma/ORM scripts, or direct SQL connection.
#
# Where to find in Supabase Dashboard:
# -> Go to: Project Settings -> Database
# -> Scroll to "Connection string" section -> select "URI" tab.
# -> Select "Transaction pooler" (port 6543) for serverless environments (Vercel).
DATABASE_URL="postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional direct connection string (port 5432) for running migrations or CLI commands
DIRECT_URL="postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 4. STAFF AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# A strong, cryptographically secure 32+ character random string used to sign
# staff session cookies with HMAC-SHA256.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_SESSION_SECRET="generate-a-random-32-character-secret-string-here"

# A secure random secret used for keyed HMAC-SHA256 calculations of OTP tokens.
# Prevents timing attacks on patient verification lookups.
OTP_HASH_SECRET="generate-another-random-32-character-secret-string-here"

# Internal virtual domain for staff login mapping (defaults to staff.bsch.local)
STAFF_AUTH_DOMAIN="staff.bsch.local"

# ------------------------------------------------------------------------------
# 5. APPLICATION DOMAIN & URLS
# ------------------------------------------------------------------------------
# The canonical public URL of the application.
# For local development: http://localhost:3000
# For production: https://bsch-clinics.vercel.app or your custom domain (e.g., https://clinics.bsch.gov.eg)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. ANTI-BOT / CLOUDFLARE TURNSTILE (OPTIONAL)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile secret key for protecting public booking and cancellation
# forms against spam bots. (Optional in local development; recommended in production).
# Where to find: Cloudflare Dashboard -> Turnstile -> Select Site -> Secret Key.
TURNSTILE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 7. Web Push Notifications (PRIVATE VAPID KEY MUST STAY SERVER-SIDE)
# ------------------------------------------------------------------------------
# Generate a key pair with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://bsch-clinic.com"
